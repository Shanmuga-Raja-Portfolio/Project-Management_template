# Virtual environments created by the Level 2 installers
.pmkit/venv-*/

# Real env files. Never commit keys.
# The installers only write *.env.example files, which are safe to commit.
.pmkit/env/*.env
.env
.env.*
!.env.example
!*.env.example

# Python build files
__pycache__/
*.pyc

# OS files
.DS_Store
Thumbs.db

# graphify writes its output to graphify-out/ (graph.json, GRAPH_REPORT.md, graph.html).
# Some teams commit it so others can read the report; others regenerate it.
# Uncomment the next line if you do not want to commit it.
# graphify-out/
